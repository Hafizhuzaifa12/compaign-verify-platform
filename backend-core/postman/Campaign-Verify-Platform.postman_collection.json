{
  "info": {
    "name": "Campaign Verify Platform — API",
    "description": "Auth, Users (profile + uploads), Campaigns. Set `accessToken` after login.\n\nManual checks: (1) Register with full_name + optional phone/display_name/bio. (2) POST avatar multipart with Bearer. (3) GET /users/me returns avatar_url under /uploads/...",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:8000" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"Strong@123\",\n  \"full_name\": \"Example User\",\n  \"phone\": \"+1 555 0100\",\n  \"display_name\": \"example_user\",\n  \"bio\": \"Optional short bio\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/register",
            "description": "full_name is required. Weak password returns 400."
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.access_token) { pm.environment.set('accessToken', j.access_token); }",
                  "if (j.refresh_token) { pm.environment.set('refreshToken', j.refresh_token); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"Strong@123\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          }
        },
        {
          "name": "Refresh access token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/refresh"
          }
        },
        {
          "name": "Forgot password — request OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"user@example.com\"\n}" },
            "url": "{{baseUrl}}/api/v1/auth/forgot-password/request-otp"
          }
        },
        {
          "name": "Forgot password — reset",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"otp\": \"123456\",\n  \"new_password\": \"NewStrong@123\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/forgot-password/reset"
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "GET me",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/v1/users/me"
          }
        },
        {
          "name": "PATCH me",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Updated Name\",\n  \"phone\": \"+1 555 0199\",\n  \"display_name\": null,\n  \"bio\": \"Updated bio\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/users/me"
          }
        },
        {
          "name": "POST me avatar (multipart)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": ""
                }
              ]
            },
            "url": "{{baseUrl}}/api/v1/users/me/avatar",
            "description": "Attach an image file (JPEG/PNG/WebP/GIF). Max size from MAX_UPLOAD_BYTES (default 10MB)."
          }
        },
        {
          "name": "POST me media (banner / gallery)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "kind", "value": "gallery", "type": "text" },
                { "key": "file", "type": "file", "src": "" }
              ]
            },
            "url": "{{baseUrl}}/api/v1/users/me/media"
          }
        }
      ]
    },
    {
      "name": "Campaigns",
      "item": [
        {
          "name": "Create campaign (POST)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Spring Sale\",\n  \"type\": \"Email Marketing\",\n  \"content\": \"Hello — visit https://a.com and https://b.com\",\n  \"url\": \"https://example.com/offer\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/campaigns"
          }
        },
        {
          "name": "List my campaigns (GET)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/v1/campaigns"
          }
        },
        {
          "name": "Get campaign by id (GET)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/v1/campaigns/1"
          }
        }
      ]
    }
  ]
}
