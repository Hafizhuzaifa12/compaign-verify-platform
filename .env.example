# ═══════════════════════════════════════════════════════════════
# Verit — Campaign Verification Platform
# Environment Configuration
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in real values.
# For Docker Compose: most values below are already set in
# docker-compose.yml via `environment:` blocks. This file is
# only needed when running services natively.
# ═══════════════════════════════════════════════════════════════

# ── Backend ───────────────────────────────────────────────────
SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Database (PostgreSQL) ────────────────────────────────────
# Docker:  postgresql://verit:verit_dev_password@db:5432/verit_db
# Native:  postgresql://verit:verit_dev_password@localhost:5432/verit_db
DATABASE_URL=postgresql://verit:verit_dev_password@db:5432/verit_db

# ── AI / ML service ──────────────────────────────────────────
# Docker:  http://ai:8001
# Native:  http://localhost:8001
AI_SERVICE_URL=http://ai:8001

# ── Blockchain (Anvil local node) ────────────────────────────
# Docker:  http://anvil:8545
# Native:  http://localhost:8545
BLOCKCHAIN_RPC_URL=http://anvil:8545
REGISTRY_CONTRACT_ADDRESS=
DEPLOYER_KEY=

# ── Frontend ─────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
